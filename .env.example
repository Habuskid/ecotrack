# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ecotrack_db
DB_PORT=3306

# Server & Session Configuration
PORT=3000
SESSION_SECRET=change_this_secret_in_production
NODE_ENV=development

# AI Recognition Service (Optional)
# Provide a Google Gemini API Key for genuine waste image recognition.
# If omitted or unconfigured, the system explicitly displays that AI recognition
# is unavailable and enables manual category selection.
GEMINI_API_KEY=
